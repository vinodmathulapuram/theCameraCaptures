
@page "/"
@using TheCameraCaptures.Models

<PageTitle>The Camera Captures — Photography & Stories</PageTitle>
<MetaTags Description="Portraits, landscapes, travel and city stories by The Camera Captures." />

<section class="hero">

    <!-- Full-screen rotating nature background -->
    <div class="home-background-slideshow" aria-hidden="true">
        @for (var i = 0; i < BackgroundImages.Length; i++)
        {

            <img
                src="@BackgroundImages[i]"
                alt=""
                class="nature-slide"
                style="@($"--slide-index: {i}")"
                loading="@(i == 0 ? "eager" : "lazy")"
                fetchpriority="@(i == 0 ? "high" : "auto")" />
        }

        <div class="home-background-overlay"></div>
    </div>

    

    <div class="hero-copy">
        <p class="eyebrow">
            <span class="eyebrow-line"></span>
            PHOTOGRAPHY · STORIES · FEELING
        </p>

        <h3>
            Life moves.<br />
            <em>Let’s make it</em><br />
            last.
        </h3>

        <p class="hero-intro">
            Honest moments, beautiful places, and the little details
            that deserve to be remembered.
        </p>

        <div class="hero-actions">
            <a class="button button-light" href="/portfolio">
                Explore the work <span>↗</span>
            </a>

            <a class="text-link" href="/about">
                A little about me <span>→</span>
            </a>
        </div>

        <div class="hero-note">
            <span class="status-dot"></span>
            Based in New Jersey, New York City · Available for select shoots
        </div>
        <div class="hero-bottom-mark">
        SCROLL TO EXPLORE <span>↓</span>
    </div>
    </div>

</section>

<section class="intro-strip">
    <p>NOT JUST WHAT IT LOOKS LIKE.</p>
    <p class="intro-big">What it <em>felt like.</em></p>
    <p class="intro-small">
        A collection of people, places, and passing moments — seen through my lens.
    </p>
</section>

@* Keep your existing featured photo collection here when you want to display it. *@

<section class="statement-band">
    @* <span class="statement-number">01 / THE APPROACH</span> *@

    <p>
        “The best photographs don’t just show you a moment.
        They <em>take you back to it.</em>”
    </p>

    <a class="button button-outline" href="/about">
        Meet the photographer <span>↗</span>
    </a>

    <div class="band-orbit orbit-one"></div>
    <div class="band-orbit orbit-two"></div>
</section>

<section class="section final-cta">
    <p class="eyebrow">HAVE A STORY IN MIND?</p>

    <h4>
        Let’s make something<br />
        <em>worth keeping.</em>
    </h4>

    <a class="button button-dark" href="/contact">Start a conversation <span>↗</span></a>
</section>




