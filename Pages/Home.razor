    private void NextNature()
    {
        currentNatureIndex =
            (currentNatureIndex + 1) % NatureImages.Length;
    }

    private void PreviousNature()
    {
        currentNatureIndex =
            (currentNatureIndex - 1 + NatureImages.Length)
            % NatureImages.Length;
    }
}