@page "/"
@using TheCameraCaptures.Models

<PageTitle>The Camera Captures — Photography & Stories</PageTitle>
<MetaTags Description="Portraits, landscapes, travel and city stories by The Camera Captures." />

<section class="hero">
    <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-line"></span> PHOTOGRAPHY · STORIES · FEELING</p>
        <h1>Life moves.<br /><em>Let’s make it</em><br />last.</h1>
        <p class="hero-intro">Honest moments, beautiful places, and the little details that deserve to be remembered.</p>
        <div class="hero-actions">
            <a class="button button-light" href="/portfolio">Explore the work <span>↗</span></a>
            <a class="text-link" href="/about">A little about me <span>→</span></a>
        </div>
        <div class="hero-note"><span class="status-dot"></span> Based in New Jersey, New York City · Available for select shoots</div>
    </div>
    <div class="hero-visual">
        <div class="hero-image-frame">
            <img src="https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=1600&q=90" alt="A quiet mountain lake reflecting the landscape" />
        </div>
        <div class="image-index"><span>01</span> / A WORLD IN FRAMES</div>
        <div class="hero-sticker">SEE<br />THE<br /><em>FEELING</em></div>
        <div class="hero-side-label">VISUAL JOURNAL — EST. WITH CURIOSITY</div>
    </div>
    <div class="hero-bottom-mark">SCROLL TO EXPLORE <span>↓</span></div>
</section>

<section class="intro-strip">
    <p>NOT JUST WHAT IT LOOKS LIKE.</p>
    <p class="intro-big">What it <em>felt like.</em></p>
    <p class="intro-small">A collection of people, places, and passing moments — seen through my lens.</p>
</section>

<section class="section featured-section">
    <div class="section-heading">
        <div><p class="eyebrow">A FEW RECENT FAVORITES</p><h2>Selected <em>frames</em></h2></div>
        <a class="text-link" href="/portfolio">View all work <span>↗</span></a>
    </div>
    <div class="photo-grid home-grid">
        @foreach (var photo in SamplePhotos.All.Take(4))
        {
            <PhotoCard Photo="photo" />
        }
    </div>
</section>

<section class="statement-band">
    <span class="statement-number">01 / THE APPROACH</span>
    <p>“The best photographs don’t just show you a moment. They <em>take you back to it.</em>”</p>
    <a class="button button-outline" href="/about">Meet the photographer <span>↗</span></a>
    <div class="band-orbit orbit-one"></div><div class="band-orbit orbit-two"></div>
</section>

<section class="section final-cta">
    <p class="eyebrow">HAVE A STORY IN MIND?</p>
    <h2>Let’s make something<br /><em>worth keeping.</em></h2>
    <a class="button button-dark" href="/contact">Start a conversation <span>↗</span></a>
</section>
